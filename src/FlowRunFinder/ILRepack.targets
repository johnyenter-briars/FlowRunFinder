<Project>
  <!--
    Custom ILRepack target for FlowRunFinder.
    This file's presence stops the package's default "merge everything" target from running.
    We use distinct target names so the package's same-named stubs (with false conditions)
    do not shadow ours at MSBuild override resolution time.
  -->
  <Target Name="ILRepackDependencies" AfterTargets="Build" Condition="$(Configuration.Contains('Release'))">
    <ItemGroup>
      <ILRepackInputs Include="$(OutputPath)$(AssemblyName).dll" />
      <ILRepackInputs Include="$(OutputPath)FlowRunFinderV2.Core.dll" />
      <ILRepackInputs Include="$(OutputPath)Microsoft.Identity.Client.dll" />
      <ILRepackInputs Include="$(OutputPath)Microsoft.Identity.Client.Extensions.Msal.dll" />
      <ILRepackInputs Include="$(OutputPath)Microsoft.IdentityModel.Abstractions.dll" />
      <ILRepackInputs Include="$(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll" />
      <ILRepackInputs Include="$(OutputPath)System.IO.FileSystem.AccessControl.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Security.AccessControl.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Security.Cryptography.ProtectedData.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Security.Principal.Windows.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Threading.Tasks.Extensions.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Memory.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Buffers.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Diagnostics.DiagnosticSource.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Text.Json.dll" />
      <ILRepackInputs Include="$(OutputPath)System.Text.Encodings.Web.dll" />
      <ILRepackInputs Include="$(OutputPath)System.ValueTuple.dll" />
    </ItemGroup>
    <ILRepack
      Internalize="true"
      InputAssemblies="@(ILRepackInputs)"
      OutputFile="$(OutputPath)$(AssemblyName).dll"
      TargetKind="Dll"
      XmlDocumentation="false"
      Parallel="true"
      LibraryPath="$(OutputPath)"
    />
    <Message Importance="high" Text="ILRepack: merged plugin dependencies into $(OutputPath)$(AssemblyName).dll" />
  </Target>

  <!-- Remove the now-redundant loose DLLs from the output folder. -->
  <Target Name="CleanMergedDependencyDlls" AfterTargets="ILRepackDependencies" Condition="$(Configuration.Contains('Release'))">
    <Delete Files="
      $(OutputPath)FlowRunFinderV2.Core.dll;
      $(OutputPath)Microsoft.Identity.Client.dll;
      $(OutputPath)Microsoft.Identity.Client.Extensions.Msal.dll;
      $(OutputPath)Microsoft.IdentityModel.Abstractions.dll;
      $(OutputPath)Microsoft.Bcl.AsyncInterfaces.dll;
      $(OutputPath)System.IO.FileSystem.AccessControl.dll;
      $(OutputPath)System.Security.AccessControl.dll;
      $(OutputPath)System.Security.Cryptography.ProtectedData.dll;
      $(OutputPath)System.Security.Principal.Windows.dll;
      $(OutputPath)System.Runtime.CompilerServices.Unsafe.dll;
      $(OutputPath)System.Threading.Tasks.Extensions.dll;
      $(OutputPath)System.Memory.dll;
      $(OutputPath)System.Buffers.dll;
      $(OutputPath)System.Numerics.Vectors.dll;
      $(OutputPath)System.Diagnostics.DiagnosticSource.dll;
      $(OutputPath)System.Text.Json.dll;
      $(OutputPath)System.Text.Encodings.Web.dll;
      $(OutputPath)System.ValueTuple.dll
    " />
    <Message Importance="high" Text="ILRepack: removed loose merged dependency DLLs from output" />
  </Target>
</Project>
